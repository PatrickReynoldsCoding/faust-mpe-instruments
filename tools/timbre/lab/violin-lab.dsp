declare name "Violin lab";
declare range "196 1300";
import("stdfaust.lib");
mpe = library("mpe.lib");
bowed = library("bowed.lib")[
    bowSpeedMin = hslider("bowSpeedMin", 0.012, 0, 1, 0.001);
    bowSpeedMax = hslider("bowSpeedMax", 0.5, 0, 2, 0.001);
    bowForceK = hslider("bowForceK", 1.0, 0, 10, 0.001);
    bowForceLoud = hslider("bowForceLoud", 1.4, 0, 10, 0.001);
    bowForceSoft = hslider("bowForceSoft", 1.5, 0, 10, 0.001);
    bowPosNear = hslider("bowPosNear", 0.06, 0.01, 0.5, 0.001);
    bowPosFar = hslider("bowPosFar", 0.2, 0.01, 0.5, 0.001);
    bowPosLoud = hslider("bowPosLoud", 0.75, 0, 1, 0.001);
    bowStartSoft = hslider("bowStartSoft", 0.2, 0.001, 1, 0.001);
    bowStartHard = hslider("bowStartHard", 0.015, 0.001, 1, 0.001);
    muS = hslider("muS", 0.8, 0, 2, 0.001);
    muD = hslider("muD", 0.3, 0, 2, 0.001);
    u0 = hslider("u0", 0.1, 0.001, 1, 0.001);
    u0Speed = hslider("u0Speed", 0.25, 0.001, 2, 0.001);
    t60High = hslider("t60High", 0.1, 0.01, 5, 0.001);
    t60HighSlope = hslider("t60HighSlope", 1.25, -2, 4, 0.01);
    bowPosWander = hslider("bowPosWander", 0.3, 0, 0.5, 0.001);
    t60Low = hslider("t60Low", 1.5, 0.05, 10, 0.01);
    frictionNoise = hslider("frictionNoise", 0.03, 0, 1, 0.001);
    bowNoise = hslider("bowNoise", 0.02, 0, 1, 0.001);
    sympathy = hslider("sympathy", 0.002, 0, 1, 0.001);
    vibCents = hslider("vibCents", 0, 0, 100, 0.1);
    vibRate = hslider("vibRate", 5.8, 0, 12, 0.01);
    brightLoud = hslider("brightLoud", 10, -20, 20, 0.01);
    debugStuck = hslider("debugStuck", 0, 0, 1, 1);
    registerTilt = hslider("registerTilt", 3.5, -20, 20, 0.01);
    registerRef = hslider("registerRef", 700, 20, 2000, 1);
    bowJitter = hslider("bowJitter", 0.08, 0, 0.5, 0.001);
    ringMix = hslider("ringMix", 0.8, 0, 2, 0.001);
    ringT60 = hslider("ringT60", 0.12, 0.01, 1, 0.001);
    ringHP = hslider("ringHP", 1000, 20, 5000, 1);
    openStrings = (196, 293.66, 440, 659.26);
    body = _ <: (library("body_violin.lib").body, _) : select2(hslider("raw", 0, 0, 1, 1));
    outGain = hslider("outGain", 0.5, 0, 4, 0.001);
];
process = bowed.voice(mpe.freq, mpe.gate, mpe.pressure, mpe.slide, mpe.velocity, mpe.legato);
post = bowed.post;

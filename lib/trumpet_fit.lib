centres = (250.000, 450.000, 800.000, 1500.000, 2600.000, 4500.000, 8000.000);
q = 1.0;
fref = 330;
a = (4.412, 20.728, 14.793, 35.654, -3.328, -12.012, 0.141);
b = (-21.747, -12.188, -9.378, -30.063, 8.823, 9.544, -3.156);
c = (-52.601, 19.636, -3.521, 12.100, -3.536, 9.528, 3.231);
// the bank's loudness in dB: n0 + n1 L + n2 L^2 + n3 R + n4 R^2 + n5 L R (taken out by the instrument)
norm = (36.895, -32.976, 3.363, 0.495, 2.250, -6.658);

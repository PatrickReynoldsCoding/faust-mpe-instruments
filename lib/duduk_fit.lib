// duduk: tone fitted to ROLI's Seaboard demo (generated by tools/fitting/seaboard/brass-duduk/fit.py).
// Peaking filters (RBJ, fixed centres and Q); gain dB = a + b*breath + c*log2(f0/fref).
centres = (300.000, 550.000, 950.000, 1600.000, 2600.000, 4200.000, 7000.000);
q = 1.0;
fref = 300;
a = (9.212, 8.330, 24.298, -17.833, 2.177, -0.540, -3.129);
b = (2.683, 0.047, -19.575, 22.048, 6.104, 0.411, -0.499);
c = (-10.180, 10.109, 0.350, 2.734, 5.536, -3.159, 3.172);
// the bank's loudness in dB: n0 + n1 L + n2 L^2 + n3 R + n4 R^2 + n5 L R (taken out by the instrument)
norm = (18.481, -3.716, 1.519, 5.914, 2.909, -1.545);
